{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "rootDir": "./src",
    "allowUmdGlobalAccess": true,
    "outDir": "./build/src",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "express", "./src/custom.d.ts"]
  },
  "include": ["src/**/**/*.ts"],   
  "exclude": ["node_modules"]
}
